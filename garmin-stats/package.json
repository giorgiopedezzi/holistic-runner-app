{
  "name": "garmin-stats",
  "version": "2.0.0",
  "description": "Personal health dashboard — Garmin 965 + Withings",
  "type": "module",
  "scripts": {
    "sync:garmin": "node --env-file=.env src/jobs/sync-garmin.ts",
    "sync:garmin:v": "node --env-file=.env src/jobs/sync-garmin.ts --verbose",
    "withings:login": "node --env-file=.env src/jobs/withings-login.ts",
    "sync:withings": "node --env-file=.env src/jobs/sync-withings.ts",
    "sync:strava": "node --env-file=.env src/jobs/sync-strava.ts",
    "sync:all": "node --env-file=.env src/jobs/sync-garmin.ts && node --env-file=.env src/jobs/sync-withings.ts && node --env-file=.env src/jobs/sync-strava.ts",
    "server": "node --env-file-if-exists=.env src/server.ts",
    "server:watch": "node --env-file-if-exists=.env --watch src/server.ts",
    "reprocess:fit": "node --env-file=.env src/jobs/reprocess-fit-archive.ts",
    "cleanup:plan-instance-dates": "node --env-file=.env src/jobs/cleanup-plan-instance-day-dates.ts",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:status": "node --env-file-if-exists=.env src/db/migrate.ts --status",
    "db:bootstrap-founder": "node --env-file-if-exists=.env src/db/bootstrap-founder.ts",
    "db:bind-founder-identity": "node --env-file-if-exists=.env src/db/bind-founder-identity.ts",
    "db:import-sqlite": "node --env-file-if-exists=.env src/db/import-sqlite.ts",
    "db:verify-import": "node --env-file-if-exists=.env src/db/verify-import.ts",
    "db:verify-ownership": "node --env-file-if-exists=.env src/db/verify-ownership.ts",
    "db:verify-schema": "node --env-file-if-exists=.env src/db/verify-schema.ts",
    "test": "node --env-file=.env.test --test \"test/**/*.test.ts\"",
    "test:watch": "node --env-file=.env.test --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.214.0",
    "@types/pg": "^8.23.1",
    "fit-file-parser": "^4.1.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  }
}
