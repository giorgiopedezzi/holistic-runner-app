tests/after/
tests/_verify/

# ── raw .FIT archive (kept locally for richer re-parsing, not committed) ───
garmin-stats/fit-archive/

# ── raw Strava API responses (kept locally, same reasoning as fit-archive) ─
garmin-stats/strava-archive/

# ── uploaded custom background images (Settings tab appearance) ────────────
garmin-stats/backgrounds/

# ── dependencies ──────────────────────────────────────────────────────────
node_modules/

