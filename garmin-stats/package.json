{
  "name": "garmin-stats",
  "version": "2.0.0",
  "description": "Personal health dashboard — Garmin 965 + Withings",
  "type": "module",
  "scripts": {
    "sync:garmin": "node src/jobs/sync-garmin.ts",
    "sync:garmin:v": "node src/jobs/sync-garmin.ts --verbose",
    "withings:login": "node src/jobs/withings-login.ts",
    "sync:withings": "node src/jobs/sync-withings.ts",
    "sync:strava": "node src/jobs/sync-strava.ts",
    "sync:all": "node src/jobs/sync-garmin.ts && node src/jobs/sync-withings.ts && node src/jobs/sync-strava.ts",
    "server": "node src/server.ts",
    "server:watch": "node --watch src/server.ts",
    "reprocess:fit": "node src/jobs/reprocess-fit-archive.ts",
    "cleanup:plan-instance-dates": "node src/jobs/cleanup-plan-instance-day-dates.ts",
    "test": "node --env-file=.env.test --test \"test/**/*.test.ts\"",
    "test:watch": "node --env-file=.env.test --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.214.0",
    "fit-file-parser": "^4.1.0",
    "zod": "^4.4.3"
  }
}
