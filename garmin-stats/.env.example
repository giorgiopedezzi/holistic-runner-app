# Copy to .env and fill in real values. Loaded via Node 24's native
# --env-file flag (see README.md) — no dotenv dependency.
#
# Only DB_PATH is required to boot the server. Every other section
# (garmin/withings/strava/ollama) is validated lazily, only when that
# integration is actually used — leave a section blank if you don't use it.

# ── Database (required at boot) ─────────────────────────────────────────────
# Absolute path, or resolved relative to the process's working directory.
DB_PATH=./garmin.db

# ── Garmin (required only for `npm run sync:garmin`) ────────────────────────
GARMIN_DEVICE_NAME=Forerunner 965

# ── Withings OAuth (required only for Withings login/sync) ─────────────────
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:3002/callback

# ── Strava OAuth (required only for Strava login/sync) ──────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3001/api/v1/strava/callback

# ── Integration credential encryption (required only when a Withings/Strava
# token is actually saved/read — HRA-352) ───────────────────────────────────
# AES-256-GCM key: 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every previously-stored token undecryptable —
# affected users must reconnect.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ── Sync behavior (optional — "true"/"false", default true for both) ───────
SYNC_AUTO_ON_START=true
SYNC_SKIP_DUPLICATES=true

# ── Ollama (required only for AI workout classification) ───────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ── Plan Template AI (required only for AI-assisted plan template
# generation) — a chat-completions-style external provider called with
# Bearer auth ────────────────────────────────────────────────────────────
PLAN_TEMPLATE_AI_ENDPOINT=
PLAN_TEMPLATE_AI_API_KEY=
PLAN_TEMPLATE_AI_MODEL=
