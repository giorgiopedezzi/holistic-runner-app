# Copy to .env and fill in real values. Loaded via Node 24's native
# --env-file flag (see README.md) — no dotenv dependency.
#
# Only DB_PATH is required to boot the server. Every other section
# (garmin/withings/strava/ollama) is validated lazily, only when that
# integration is actually used — leave a section blank if you don't use it.

# ── Database (required at boot) ─────────────────────────────────────────────
# Absolute path, or resolved relative to the process's working directory.
DB_PATH=./garmin.db

# ── Garmin (required only for `npm run sync:garmin`) ────────────────────────
GARMIN_DEVICE_NAME=Forerunner 965

# ── Withings OAuth (required only for Withings login/sync) ─────────────────
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:3002/callback

# ── Strava OAuth (required only for Strava login/sync) ──────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3001/api/v1/strava/callback

# ── Integration credential encryption (required only when a Withings/Strava
# token is actually saved/read — HRA-352) ───────────────────────────────────
# AES-256-GCM key: 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every previously-stored token undecryptable —
# affected users must reconnect.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# ── Sync behavior (optional — "true"/"false", default true for both) ───────
SYNC_AUTO_ON_START=true
SYNC_SKIP_DUPLICATES=true

# FIT ZIP upload limits (optional; defaults shown, values are bytes/counts).
# Archives are processed in memory and raw ZIP/FIT bytes are never retained.
FIT_ZIP_MAX_COMPRESSED_BYTES=10485760
FIT_ZIP_MAX_EXPANDED_BYTES=52428800
FIT_ZIP_MAX_ENTRY_BYTES=10485760
FIT_ZIP_MAX_ENTRIES=256
FIT_ZIP_PARSE_CONCURRENCY=2

# ── Ollama (required only for AI workout classification) ───────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# ── Plan Template AI (required only for AI-assisted plan template
# generation) — a chat-completions-style external provider called with
# Bearer auth ────────────────────────────────────────────────────────────
PLAN_TEMPLATE_AI_ENDPOINT=
PLAN_TEMPLATE_AI_API_KEY=
PLAN_TEMPLATE_AI_MODEL=

# ── Auth (optional — required only when AUTH_ENABLED=true) ─────────────────
# Session/OIDC login. AUTH_ENABLED defaults false ("true"/"false", fail-closed
# on anything else); every var below is only read/validated once it's true.
AUTH_ENABLED=false
AUTH_ISSUER_URL=
AUTH_DISCOVERY_URL=
AUTH_AUDIENCE=
# "founders_only" (default) or "open" — see the ADR for AC5.
AUTH_REGISTRATION_MODE=founders_only
# Comma-separated emails allowed to register the first-ever internal user.
AUTH_FOUNDER_ALLOWLIST=
# Session lifetime, in seconds (defaults: 1800 = 30min idle, 43200 = 12h
# absolute) — idle must not exceed absolute or the idle timeout can never fire.
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
# How long the OAuth-redirect preauth cookie (state/nonce binding) survives,
# in seconds (default 600 = 10min) — only needs to outlive the redirect round trip.
AUTH_PREAUTH_COOKIE_SECONDS=600
AUTH_WEB_CLIENT_ID=
AUTH_WEB_CLIENT_SECRET=
AUTH_WEB_CALLBACK_URL=
AUTH_WEB_LOGOUT_URL=
# Comma-separated list of origins allowed to call the API with credentials.
AUTH_ALLOWED_ORIGINS=

# ── FIT export allowance (HRA-391 — optional, defaults shown) ───────────────
# Rolling-window credits for registered-user single-workout/week FIT export.
# The founder account is exempt regardless of these values.
EXPORT_ALLOWANCE_LIMIT=7
EXPORT_ALLOWANCE_WINDOW_DAYS=7
EXPORT_ALLOWANCE_COST_SINGLE=1
EXPORT_ALLOWANCE_COST_WEEK=7
