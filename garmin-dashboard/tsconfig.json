{
  "compilerOptions": {
    "target":           "ES2020",
    "useDefineForClassFields": true,
    // ES2022.Intl only adds type declarations (Intl.supportedValuesOf, used
    // by AccountPrivacySection.tsx's timezone picker) — target/emit stay
    // ES2020, this doesn't change what JS actually ships.
    "lib":              ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "module":           "ESNext",
    "skipLibCheck":     true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules":  true,
    "noEmit":           true,
    "jsx":              "react-jsx",
    "strict":           true,
    "noUnusedLocals":   true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types":            ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
